<?xml version="1.0" encoding="utf-8"?>
<!-- Knockdown copy of ../spirob_pedestal.xml: white, and 20 mm lower (cup top 46 mm above the
     table when the pedestal root sits at z = 2 mm) so the drooping real robot meets the egg. -->
<mujoco model="SpiRob_Pedestal_Knockdown">
  <compiler angle="radian" inertiafromgeom="true" autolimits="true" />
  <default>
    <geom density="1200" friction="0.8 0.05 0.005" rgba="0.93 0.93 0.93 1" contype="1" conaffinity="1" />
  </default>
  <worldbody>
    <body name="pedestal" pos="0 0 0">
      <geom name="ped_shaft" type="cylinder" pos="0 0 0.0185" size="0.008 0.02" contype="1" conaffinity="1" />
      <geom name="ped_cup" type="box" pos="0 0 0.04" size="0.014 0.014 0.004" contype="1" conaffinity="1" />
    </body>
  </worldbody>
</mujoco>
